import random

# Tooted, mille kohta kasutajalt küsitakse (vähemalt 5 toodet)
tooted = ["piim", "sai", "leib", "juust", "õunad", "kohv"]

# Loome igale tootele juhusliku hinna vahemikus 0.50 kuni 3.00 €
hinnad = {}
for toode in tooted:
    hinnad[toode] = round(random.uniform(0.5, 3), 2)

ostukorv = []

print("Tere tulemast poodi! Vali sobivad tooted.\n")

# Küsime iga toote kohta eraldi
for toode in tooted:
    hind = hinnad[toode]
    vastus = input(f"Kas soovid osta toodet '{toode}' (hind {hind:.2f} €)? (jah/ei): ").strip().lower()
    
    if vastus == "jah":
        while True:
            kogus_str = input(f"Mitu tükki/ühikut toodet '{toode}' soovid?: ").strip()
            # Kontrollime, et sisestatud väärtus on täisarv ja suurem kui 0
            if kogus_str.isdigit() and int(kogus_str) > 0:
                kogus = int(kogus_str)
                summa = round(kogus * hind, 2)
                ostukorv.append({
                    "nimi": toode,
                    "kogus": kogus,
                    "hind": hind,
                    "summa": summa
                })
                break
            else:
                print("Viga! Palun sisesta korrektne positiivne täisarv.")

# Kuvame tšeki
print("\n" + "=" * 45)
print("                   OSTUTŠEKK")
print("=" * 45)

if not ostukorv:
    print("Ostukorv on tühi. Aitäh külastamast!")
else:
    print(f"{'Toode':<12} {'Kogus':<8} {'Hind':<10} {'Summa':<10}")
