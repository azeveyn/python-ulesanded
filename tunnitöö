        print(f"{rida['nimi'].capitalize():<12} {rida['kogus']:<8} {rida['hind']:<9.2f}€ {rida['summa']:<9.2f}€")
        kogusumma += rida["summa"]
        
    print("-" * 45)
    print(f"{'KOKKU:':<32} {kogusumma:.2f} €")
print("=" * 45)
