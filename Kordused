# 5
# Koosta programm, mis arvutab ainult negatiivsete arvude summa N sisestatud arvu seast.
# N väärtus sisestatakse klaviatuurilt.
# õpilased kirjutavad ise
try:
    N = int(input("Sisesta arvude hulk N: "))
    negatiivsed = 0
    positiivsed = 0
    nullid = 0
    for i in range(N):
        try:
            arv = float(input(f"{i + 1}. arv: "))
            if arv < 0:
                negatiivsed += 1
            elif arv > 0:
                positiivsed += 1
            else:
                nullid += 1
        except ValueError:
            print("Palun sisestage arv. ")
    print(f"Negatiivsete arvude arv: {negatiivsed}")
    print(f"positiivsed arvude arv: {positiivsed}")
    print(f"nullid arv: {nullid}")
except ValueError:
    print("Palun sisestage täisarv. ")
#6
N = int(input("Mitu arvu sisestad? "))

# 1. FOR tsükkel
pos = neg = nullid = 0
for i in range(N):
    arv = float(input(f"Sisesta {i+1}. arv: "))
    if arv > 0:
        pos += 1
    elif arv < 0:
        neg += 1
    else:
        nullid += 1
print(f"FOR: Positiivseid: {pos}, Negatiivseid: {neg}, Nulle: {nullid}")

# 2. WHILE tsükkel
pos = neg = nullid = i = 0
while i < N:
    arv = float(input(f"Sisesta {i+1}. arv: "))
    if arv > 0:
        pos += 1
    elif arv < 0:
        neg += 1
    else:
        nullid += 1
    i += 1
print(f"WHILE: Positiivseid: {pos}, Negatiivseid: {neg}, Nulle: {nullid}")

# 3. WHILE True tsükkel
pos = neg = nullid = i = 0
while True:
    if i >= N:
        break
    arv = float(input(f"Sisesta {i+1}. arv: "))
    if arv > 0:
        pos += 1
    elif arv < 0:
        neg += 1
    else:
        nullid += 1
    i += 1
print(f"WHILE True: Positiivseid: {pos}, Negatiivseid: {neg}, Nulle: {nullid}")
#7
A = int(input("Sisesta algus A: "))
B = int(input("Sisesta lõpp B: "))
K = int(input("Sisesta jagaja K: "))

# 1. FOR tsükkel
print("FOR:", end=" ")
for i in range(A, B + 1):
    if i % K == 0:
        print(i, end=" ")
print()

# 2. WHILE tsükkel
print("WHILE:", end=" ")
i = A
while i <= B:
    if i % K == 0:
        print(i, end=" ")
    i += 1
print()

# 3. WHILE True tsükkel
print("WHILE True:", end=" ")
i = A
while True:
    if i > B:
        break
    if i % K == 0:
        print(i, end=" ")
    i += 1
print()

