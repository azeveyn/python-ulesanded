# 5
# Koosta programm, mis arvutab ainult negatiivsete arvude summa N sisestatud arvu seast.
# N väärtus sisestatakse klaviatuurilt.
try:
    N = int(input("Sisesta arvude hulk N: "))
    neg_summa = 0
    for i in range(N):
        try:
            arv = float(input(f"{i + 1}. arv: "))
            if arv < 0:
                neg_summa += arv
        except ValueError:
            print("Palun sisestage arv. ")
    print(f"Negatiivsete arvude summa on {neg_summa}")
except ValueError:
    print("Palun sisestage täisarv. ")

# 6
# Klaviatuurilt sisestatakse N arvu.
# Koosta programm, mis määrab sisestatud arvude seast:
# negatiivsete arvude arvu, positiivsete arvude arvu, nullide arvu.
N = int(input("Mitu arvu sisestad? "))

# 1. FOR tsükkel
pos = neg = nullid = 0
for i in range(N):
    arv = float(input(f"Sisesta {i+1}. arv: "))
    if arv > 0:
        pos += 1
    elif arv < 0:
        neg += 1
    else:
        nullid += 1
print(f"FOR: Positiivseid: {pos}, Negatiivseid: {neg}, Nulle: {nullid}")

# 2. WHILE tsükkel
pos = neg = nullid = i = 0
while i < N:
    arv = float(input(f"Sisesta {i+1}. arv: "))
    if arv > 0:
        pos += 1
    elif arv < 0:
        neg += 1
    else:
        nullid += 1
    i += 1
print(f"WHILE: Positiivseid: {pos}, Negatiivseid: {neg}, Nulle: {nullid}")

# 3. WHILE True tsükkel
pos = neg = nullid = i = 0
while True:
    if i >= N:
        break
    arv = float(input(f"Sisesta {i+1}. arv: "))
    if arv > 0:
        pos += 1
    elif arv < 0:
        neg += 1
    else:
        nullid += 1
    i += 1
print(f"WHILE True: Positiivseid: {pos}, Negatiivseid: {neg}, Nulle: {nullid}")

# 7
# Väljastada ekraanile arvud, mis on K-ga jaguvad vahemikust [A, B].
A = int(input("Sisesta algus A: "))
B = int(input("Sisesta lõpp B: "))
K = int(input("Sisesta jagaja K: "))

if K == 0:
    print("Nulliga ei saa jagada!")
else:
    # 1. FOR tsükkel
    print("FOR:", end=" ")
    for i in range(A, B + 1):
        if i % K == 0:
            print(i, end=" ")
    print()

    # 2. WHILE tsükkel
    print("WHILE:", end=" ")
    i = A
    while i <= B:
        if i % K == 0:
            print(i, end=" ")
        i += 1
    print()

    # 3. WHILE True tsükkel
    print("WHILE True:", end=" ")
    i = A
    while True:
        if i > B:
            break
        if i % K == 0:
            print(i, end=" ")
        i += 1
    print()

