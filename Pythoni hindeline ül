print("Aastaaeg")  # Parandatud: ülakoma ' asendatud jutumärgiga "
kuu = int(input("Sisesta kuu number (1-12) => "))
if kuu < 1 or kuu > 12:  # Parandatud: 'and' asendatud 'or'-iga
    print("Vigane kuu")
elif kuu == 12 or kuu <= 2:  # Parandatud: '=' asendatud võrdlusmärgiga '=='
    print("Talv")
elif 3 <= kuu <= 5:  # Parandatud: 'else if' asendatud 'elif'-iga
    print("Kevad")
elif 6 <= kuu <= 8:  # Parandatud: lisatud koolon :
    print("Suvi")  # Parandatud: lisatud taane 4 tühikut
else:
    print("Sügis")
print()

print("Kiiruse kontroll")
lubatud = int(input("Sisesta lubatud kiirus (km/h) => "))  # Parandatud: lisatud lõpusulg ')'
kiirus = int(input("Sisesta tegelik kiirus (km/h) => "))  # Parandatud: lisatud int()
yletus = kiirus - lubatud
if yletus <= 0:  # Parandatud: '=<' asendatud kujuga '<=' 
    print("Kiirust ei ületatud")
elif yletus <= 20:  # Parandatud: tingimuse vahemik muudetud, et jõuaks ka järgmiste harudeni
    print("Hoiatus")
elif yletus <= 40:  # Parandatud: vahemik 21-40 annab trahvi
    print("Trahv")
else:  # Parandatud: üle 40 ületamise puhul võetakse juhiluba ära
    print("Juhiluba võetakse ära")
print()

print("Taksosõit")
km = float(input("Sisesta sõidu pikkus (km) => "))
oo = input("Kas sõit on öösel (jah/ei)? => ")
hind = 3 + km * 0.8  # Parandatud: teine '+' asendatud korrutusmärgiga '*'
if oo == "jah" or oo == "JAH":  # Parandatud: 'and' asendatud 'or'-iga ja lisatud koolon ':'
    hind = hind * 1.2
print("Sõidu hind:", round(hind, 2), "€")  # Parandatud: lisatud lõpusulg ')'

